{
  "$schema": "https://ui.shadcn.com/schema.json",
  "name": "faq-schema",
  "description": "FAQ Schema Registry - Rich snippets and structured data components for better SEO",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "app/globals.css",
    "baseColor": "gray",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui"
  },
  "registry": [
    {
      "name": "faq-schema",
      "type": "registry:ui",
      "description": "A component that generates JSON-LD structured data for FAQ pages to improve SEO and rich snippets",
      "dependencies": [],
      "devDependencies": [],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/registry/faq-schema/ui/faq-schema.tsx",
          "content": "",
          "type": "registry:component",
          "target": ""
        }
      ],
      "tailwind": {},
      "cssVars": {},
      "meta": {
        "importSpecifier": "FAQSchema",
        "moduleSpecifier": "./faq-schema"
      }
    }
  ]
}
