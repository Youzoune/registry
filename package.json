{
  "name": "youzoune-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Youzoune public registry for shadcn/ui components",
  "scripts": {
    "dev": "next dev",
    "build": "next build && next run registry:build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "registry:build": "bun run scripts/build-registry.ts",
    "install:deps": "next install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "15.0.4",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0-alpha.35",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.0.4",
    "husky": "^9.1.7",
    "postcss": "^8",
    "prettier": "^3.7.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "shadcn": "^2.1.7",
    "tailwindcss": "^4.0.0-alpha.35",
    "tw-animate-css": "^1.0.1",
    "typescript": "^5"
  },
  "keywords": [
    "shadcn",
    "registry",
    "react",
    "components",
    "ui",
    "youzoune"
  ],
  "author": "Youzoune",
